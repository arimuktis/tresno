# ==============================================================================
# TRESNO SERVER - ENVIRONMENT VARIABLES SPECIFICATION (.env.example)
# ==============================================================================
# Salin file ini ke .env.development untuk pengembangan lokal atau .env.production untuk rilis.

# Mode Environment: development | production | test
NODE_ENV=development

# Server Networking
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=*

# Agora RTC Audio/Video Engine (https://console.agora.io)
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# Redis Cache & Matchmaking Queue (Opsional di dev, direkomendasikan di prod)
# REDIS_URL=redis://localhost:6379

# Supabase Storage 50GB & Auth (https://app.supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
STORY_BUCKET=tresno-stories

# Midtrans Payment Gateway (https://dashboard.midtrans.com)
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_IS_PRODUCTION=false
