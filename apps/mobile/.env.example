# ==============================================================================
# TRESNO CLIENT - ENVIRONMENT VARIABLES SPECIFICATION (.env.example)
# ==============================================================================
# Salin file ini ke .env.development untuk dev atau .env.production untuk rilis.

# Environment Mode: development | production | test
VITE_APP_ENV=development

# Backend API & WebSocket Signaling Endpoints
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws

# Supabase Storage & Client Auth (https://app.supabase.com)
VITE_SUPABASE_URL=https://demo-tresno.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Agora RTC App ID (https://console.agora.io)
VITE_AGORA_APP_ID=your_agora_app_id
